# ---------------------------------------------------------------
# Обязательные переменные для продакшена
# ---------------------------------------------------------------

# Пароль для входа в админку (/admin)
ADMIN_PASSWORD=

# Секрет для подписи сессий и шифрования заявок. Минимум 16 символов.
# Сгенерировать: openssl rand -base64 32
SESSION_SECRET=

# Адрес сайта — нужен для sitemap.xml, robots.txt и ссылок в соцсетях
NEXT_PUBLIC_SITE_URL=https://example.com

# Реквизиты оператора персональных данных для страницы /privacy — одной
# строкой: ФИО или наименование ИП, ИНН, адрес регистрации.
# В репозитории их нет намеренно, это личные данные владельца сайта.
LEGAL_OPERATOR=

# ---------------------------------------------------------------
# Хранилище изображений (Vercel Blob).
# Локально можно не задавать: файлы лягут в public/uploads
# ---------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# Если Vercel создал токен под другим именем (например с префиксом), а старую
# переменную удалить нельзя — впишите нужный токен сюда. Эта переменная имеет
# приоритет над всеми остальными.
SITE_BLOB_TOKEN=

# ---------------------------------------------------------------
# Уведомления о заявках в Telegram (необязательно)
# Токен выдаёт @BotFather, chat id можно узнать у @userinfobot
# ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------
# Статистика посещений (необязательно)
# Vercel Analytics включается кнопкой в панели проекта и кода не требует.
# Номер счётчика Яндекс.Метрики — только цифры, без кавычек.
# ---------------------------------------------------------------
NEXT_PUBLIC_METRIKA_ID=
